# Platform secrets (per 13 §7.1) — never commit real values
# DATABASE_URL: migration/DDL owner connection (`erp`) — used ONLY by
# `pnpm db:generate` / `pnpm db:migrate` (drizzle.config.ts, migrate.ts).
DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/erp_dev

# DATABASE_URL_APP: runtime/application connection (`erp_app`) — per the
# RLS Role Architecture Decision. NOSUPERUSER, NOBYPASSRLS, owns nothing.
# Used by packages/db/client.ts (and therefore every apps/web request) and
# by packages/db/test/rls.test.ts's default connection. Using DATABASE_URL
# (`erp`, a superuser) here instead would make every RLS policy a silent
# no-op, since superusers/table-owners bypass RLS unconditionally.
DATABASE_URL_APP=postgres://erp_app:erp_app_dev_password@localhost:5432/erp_dev

AUTH_SESSION_SECRET=replace-with-32-byte-random-value
NODE_ENV=development

# Session cookie config (13 §2.1)
SESSION_COOKIE_NAME=erp_session
SESSION_IDLE_TIMEOUT_DAYS=7
SESSION_ABSOLUTE_TIMEOUT_DAYS=30

# Redis (04 §47) — optional at Phase 1, required from Phase 4 (queue/rate-limit)
REDIS_URL=redis://localhost:6379

# Object storage (04 §56) — not required until Documents/Purchase-OCR phase
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

# Platform operator surface (ADR-001, Plan/31) -- OFF by default.
# MFA does not exist yet (13 s14 Q2), so do NOT expose this outside local development until it does.
PLATFORM_ADMIN_ENABLED=false
# Comma-separated IPv4 CIDRs / addresses allowed to reach /platform and /api/platform/*.
# Unset = open in development, DENIED in production.
PLATFORM_ADMIN_ALLOWED_CIDRS=
# Only set when behind ONE trusted reverse proxy that appends to X-Forwarded-For; the caller IP is then
# taken PROXY_HOPS entries from the right. Without it the caller IP is unknown and an allowlist denies everyone.
PLATFORM_ADMIN_TRUST_PROXY=false
PLATFORM_ADMIN_PROXY_HOPS=1

# Reverse proxy / caller address (Decision SEC-009). X-Forwarded-For is client-forgeable, so it is read ONLY when
# TRUST_PROXY=true, and then the entry appended by YOUR proxy (PROXY_HOPS from the right) is used. Without it the
# caller address is unknown: per-IP limits are skipped and the sign-in lockout keys on e-mail alone.
# (PLATFORM_ADMIN_TRUST_PROXY / PLATFORM_ADMIN_PROXY_HOPS are still honoured as older names.)
TRUST_PROXY=false
PROXY_HOPS=1
# Per-IP sign-in guard (attempts per 15 min from one address). Generous by default: shops often share an address.
RATE_LIMIT_LOGIN_IP_MAX=100
