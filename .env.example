# Platform secrets (per 13 §7.1) — never commit real values
# DATABASE_URL: migration/DDL owner connection (`erp`) — used ONLY by
# `pnpm db:generate` / `pnpm db:migrate` (drizzle.config.ts, migrate.ts).
DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/erp_dev

# DATABASE_URL_APP: runtime/application connection (`erp_app`) — per the
# RLS Role Architecture Decision. NOSUPERUSER, NOBYPASSRLS, owns nothing.
# Used by packages/db/client.ts (and therefore every apps/web request) and
# by packages/db/test/rls.test.ts's default connection. Using DATABASE_URL
# (`erp`, a superuser) here instead would make every RLS policy a silent
# no-op, since superusers/table-owners bypass RLS unconditionally.
DATABASE_URL_APP=postgres://erp_app:erp_app_dev_password@localhost:5432/erp_dev

AUTH_SESSION_SECRET=replace-with-32-byte-random-value
NODE_ENV=development

# Session cookie config (13 §2.1)
SESSION_COOKIE_NAME=erp_session
SESSION_IDLE_TIMEOUT_DAYS=7
SESSION_ABSOLUTE_TIMEOUT_DAYS=30

# Redis (04 §47) — optional at Phase 1, required from Phase 4 (queue/rate-limit)
REDIS_URL=redis://localhost:6379

# Object storage (04 §56) — not required until Documents/Purchase-OCR phase
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
