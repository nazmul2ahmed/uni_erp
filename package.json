{
  "name": "erp-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "db:generate": "pnpm --filter @erp/db generate",
    "db:migrate": "pnpm --filter @erp/db migrate",
    "db:seed": "pnpm --filter @erp/db seed",
    "operator": "pnpm --filter @erp/db exec tsx ../../apps/web/scripts/operator.ts",
    "operator:create": "pnpm --filter @erp/db exec tsx ../../apps/web/scripts/operator.ts create",
    "operator:grant": "pnpm --filter @erp/db exec tsx ../../apps/web/scripts/operator.ts grant",
    "operator:revoke": "pnpm --filter @erp/db exec tsx ../../apps/web/scripts/operator.ts revoke",
    "operator:reset-password": "pnpm --filter @erp/db exec tsx ../../apps/web/scripts/operator.ts reset-password",
    "operator:list": "pnpm --filter @erp/db exec tsx ../../apps/web/scripts/operator.ts list",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
